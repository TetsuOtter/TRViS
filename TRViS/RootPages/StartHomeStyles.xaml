<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:TRViS">

	<Style x:Key="PrimaryActionButton"
				 TargetType="Button">
		<Setter Property="HeightRequest"
						Value="84"/>
		<Setter Property="MinimumWidthRequest"
						Value="200"/>
		<Setter Property="FontSize"
						Value="20"/>
		<Setter Property="FontAttributes"
						Value="Bold"/>
		<Setter Property="CornerRadius"
						Value="12"/>
		<Setter Property="Margin"
						Value="6"/>
		<Setter Property="Padding"
						Value="16,8"/>
		<Setter Property="LineBreakMode"
						Value="WordWrap"/>
		<!-- ContentLayout (icon position) is set from code-behind
		     (StartGridView.ApplyIconContentLayout) since it must flip to
		     Right for RTL locales; no static default here. -->
	</Style>

	<!-- Border-based equivalent of PrimaryActionButton, used only by
	     ScanQrButton (see StartGridView.xaml) to sidestep a native iOS
	     UIButton icon-centering limitation. Mirrors PrimaryActionButton's
	     sizing/spacing and the base Button style's (Resources/Styles/
	     Styles.xaml) colors/disabled-state so it reads as the same button
	     despite not being a real Button. -->
	<Style x:Key="PrimaryActionButtonBorder"
				 TargetType="Border">
		<Setter Property="BackgroundColor"
						Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"/>
		<Setter Property="Stroke"
						Value="Transparent"/>
		<Setter Property="StrokeThickness"
						Value="0"/>
		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="12"/>
		</Setter>
		<Setter Property="HeightRequest"
						Value="84"/>
		<Setter Property="MinimumWidthRequest"
						Value="200"/>
		<Setter Property="Margin"
						Value="6"/>
		<Setter Property="Padding"
						Value="16,8"/>
		<Setter Property="VisualStateManager.VisualStateGroups">
			<VisualStateGroupList>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal"/>
					<!-- The base Button style swaps to a gray palette when
					     disabled; matching that per-Label here would require
					     re-implementing VisualStateManager cascading (VSM
					     setters only apply to the element they're declared on,
					     not children). Dimming the whole Border's Opacity gets
					     the same "this is disabled" read without that. -->
					<VisualState x:Name="Disabled">
						<VisualState.Setters>
							<Setter Property="Opacity"
											Value="0.4"/>
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateGroupList>
		</Setter>
	</Style>

	<Style x:Key="SecondaryActionButton"
				 TargetType="Button">
		<Setter Property="FontSize"
						Value="14"/>
		<Setter Property="HeightRequest"
						Value="44"/>
		<Setter Property="CornerRadius"
						Value="8"/>
		<Setter Property="Margin"
						Value="4"/>
		<Setter Property="HorizontalOptions"
						Value="Center"/>
		<Setter Property="MinimumWidthRequest"
						Value="180"/>
	</Style>

	<Style x:Key="LinkButton"
				 TargetType="Button">
		<Setter Property="BackgroundColor"
						Value="Transparent"/>
		<Setter Property="TextColor"
						Value="{x:Static local:RootStyles.TableTextColor}"/>
		<Setter Property="FontSize"
						Value="13"/>
		<Setter Property="Padding"
						Value="8,4"/>
		<Setter Property="Margin"
						Value="2,0"/>
		<Setter Property="HeightRequest"
						Value="32"/>
	</Style>

	<Style x:Key="StepListBorder"
				 TargetType="Border">
		<Setter Property="Stroke"
						Value="{x:Static local:RootStyles.BorderStrokeColor}"/>
		<Setter Property="BackgroundColor"
						Value="{x:Static local:RootStyles.BackgroundColor}"/>
		<Setter Property="Margin"
						Value="0,0,0,4"/>
		<Setter Property="Padding"
						Value="8"/>
		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="8"/>
		</Setter>
	</Style>

	<Style x:Key="StepChipBorder"
				 TargetType="Border">
		<Setter Property="Stroke"
						Value="{x:Static local:RootStyles.BorderStrokeColor}"/>
		<Setter Property="StrokeThickness"
						Value="1"/>
		<Setter Property="BackgroundColor"
						Value="{x:Static local:RootStyles.BackgroundBlackWhite}"/>
		<Setter Property="Margin"
						Value="0,0,0,4"/>
		<Setter Property="Padding"
						Value="12,8"/>
		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="8"/>
		</Setter>
	</Style>

</ResourceDictionary>
