<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:loc="clr-namespace:TRViS.Localization"
	xmlns:root="clr-namespace:TRViS"
	x:Class="TRViS.DTAC.NotificationBannerView">

	<!-- D-TAC 画面上部に重ねて出す、受領必須の初回小型表示・区間連動の再表示の
	     両方を担う非モーダルバナー。ViewHost が NotificationCenterViewModel の
	     BannerRequested/BannerDismissed に応じて Configure/表示切替を行う (このビュー自体は
	     イベントを購読しない、純粋に受け身のビュー)。タップで大きい中央ポップアップへ展開する。 -->
	<Border
		AutomationId="Notification.Banner"
		Stroke="{x:Static root:RootStyles.BorderStrokeColor}"
		StrokeThickness="1"
		BackgroundColor="{x:Static root:RootStyles.BackgroundColor}"
		Padding="12">
		<Border.StrokeShape>
			<RoundRectangle CornerRadius="12"/>
		</Border.StrokeShape>
		<Border.Shadow>
			<Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2"/>
		</Border.Shadow>
		<Border.GestureRecognizers>
			<TapGestureRecognizer Tapped="OnBannerTapped"/>
		</Border.GestureRecognizers>

		<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">

			<!-- アイコン: 画像 (Base64) が優先。無ければ背景色+文字のバッジ。どちらも無ければ
			     IconHost ごと非表示にして Col0 (Auto) を畳む。 -->
			<Grid
				x:Name="IconHost"
				Grid.Column="0"
				VerticalOptions="Center">
				<Border
					x:Name="IconBadge"
					IsVisible="False"
					StrokeThickness="0"
					BackgroundColor="{x:Static root:RootStyles.TableDetailColor}"
					WidthRequest="28"
					HeightRequest="28"
					Padding="0">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="14"/>
					</Border.StrokeShape>
					<Label
						x:Name="IconBadgeLabel"
						TextColor="White"
						FontSize="12"
						FontAttributes="Bold"
						HorizontalTextAlignment="Center"
						VerticalTextAlignment="Center"/>
				</Border>
				<Image
					x:Name="IconImage"
					IsVisible="False"
					WidthRequest="28"
					HeightRequest="28"
					Aspect="AspectFit"/>
			</Grid>

			<!-- 概要 (タイトル、未設定なら「通告」にフォールバック)。BBCode は展開先の
			     ポップアップでのみ表示し、ここでは 1 行のプレーンテキストに留める。 -->
			<Label
				x:Name="SummaryLabel"
				AutomationId="Notification.Banner.Summary"
				Grid.Column="1"
				FontAttributes="Bold"
				FontSize="15"
				LineBreakMode="TailTruncation"
				VerticalOptions="Center"
				TextColor="{x:Static root:RootStyles.TableTextColor}"/>

			<!-- 受領ボタン: !entry.IsRead &amp;&amp; entry.CanAcknowledge のときのみ表示 (Configure が制御)。 -->
			<Button
				x:Name="AcknowledgeButton"
				AutomationId="Notification.Banner.AcknowledgeButton"
				Grid.Column="2"
				Text="{loc:Translate Notification_Acknowledge}"
				HeightRequest="36"
				FontSize="13"
				CornerRadius="8"
				Padding="12,0"
				IsVisible="False"
				Clicked="OnAcknowledgeButtonClicked"/>

			<!-- タップで展開できることを示すシェブロン。 -->
			<Label
				x:Name="ChevronLabel"
				AutomationId="Notification.Banner.Chevron"
				Grid.Column="3"
				Text="&#xe5cc;"
				FontFamily="MaterialIconsRegular"
				FontSize="24"
				VerticalOptions="Center"
				TextColor="{x:Static root:RootStyles.TableDetailColor}"/>

		</Grid>
	</Border>
</ContentView>
